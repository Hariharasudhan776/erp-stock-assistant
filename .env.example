# Copy to .env and fill in.

# Anthropic API key (required)
ANTHROPIC_API_KEY=

# Model + effort. Cheaper alternative: claude-haiku-4-5 (about 5x cheaper per question)
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=low

# Oracle credentials are read from environment variables named <DB_PROFILE>USER / PWD / DSN / SCHEMA,
# e.g. ORA_USER=readonly_user  ORA_PWD=...  ORA_DSN=MYDB  ORA_SCHEMA=ERP
DB_PROFILE=ORA_

# Oracle client directory for thick mode (needed for servers older than 12.1). Empty = thin mode.
ORACLE_CLIENT_DIR=

# Safety limits
MAX_ROWS=200
SQL_TIMEOUT_SEC=60
DAILY_BUDGET_USD=2.00


# PORT=8765
